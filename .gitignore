# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Editors
.idea/
.vscode/
.DS_Store

# Logs
*.log

# Runtime-generated caches and outputs
prediction_cache/
video_index_cache.json

# Local/private demo data. Keep only the instructions tracked.
examples/*
!examples/README.md

# Local model packages and common large media/data formats
model_packages/
*.mp4
*.mkv
*.avi
*.mov
*.jsonl

# Trained models are external; do not include them in source or program releases
*.pt
!tests/**/*.pt

# Portable distributions / local build inputs (Release assets, never Git blobs)
/runtime/
/model_runtime_*/
/vendor/
/logs/
/COWMATA.exe
/output/
/tmp/
*.exe
*.dll
*.pyd
*.onnx
*.pkl
*.pickle
*.joblib
*.npz
*.zip
*.7z
*.nupkg
*.partial
*.sha256
/assets/brand/cowmata.ico

# Windows shell caches from hosts with incomplete environment variables
/%SystemDrive%/

# 3.9 external numeric model library
/assets/algorithms/
/assets/dataset_recipes/cowmata_temperature_aux/model.json
